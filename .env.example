# 문의 접수 API (woori) — .env.local 로 복사한 뒤 값을 채우세요.
#
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 노출됩니다.
# 비밀키를 절대 넣지 마세요. 아래 세 값은 한강미디어 번들에서도 공개돼 있는 종류입니다.

# API 서버 주소
NEXT_PUBLIC_WOORI_API_URL=https://woori-api-80.doweb.kr:3000

# 아름텍 사이트 식별자 (요청 시 x-site 헤더로 전송)
NEXT_PUBLIC_WOORI_SITE_ID=

# 문의 알림에 쓸 메시지 템플릿 번호 (채널별). 비워두면 이메일 1000, 문자 2 를 쓴다.
#
# 이메일 1000 = 문의 전용 템플릿 (백엔드에 등록됨). 문의 내용이 표로 정리돼 나간다.
# 문자  2    = 공용 알림 템플릿. 문자용 1000 템플릿은 아직 등록되지 않아 501 이 난다.
#             등록되면 NEXT_PUBLIC_INQUIRY_SMS_OPTION=1000 으로 바꾸면 된다.
#
# 문의 수신처(관리자 이메일·연락처)는 코드가 아니라 woori 사이트 설정을 따른다 (send_admin).
NEXT_PUBLIC_INQUIRY_EMAIL_OPTION=
NEXT_PUBLIC_INQUIRY_SMS_OPTION=

# 자료실 첨부파일 다운로드용 파일서버 (iwinv). 예: https://arumtech.iwinv.net
NEXT_PUBLIC_WOORI_FILE_URL=

# 제품 상세의 브로슈어·시방서·도면(dwg) 다운로드 호스트.
# 이 파일들은 용량이 커서 저장소에 넣지 않고 iwinv 파일서버(public_html/downloads)에 둔다.
# 비워두면 로컬 public/downloads 에서 서빙한다.
# 예: https://arumtech.iwinv.net
NEXT_PUBLIC_PRODUCT_FILE_URL=
