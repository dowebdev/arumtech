# arumtech.doweb.kr — Next.js 를 PM2 로 띄우고(127.0.0.1:3100) Apache 가 프록시한다.
#
# 이 호스팅의 기본 설정은 정적 SPA 용(모든 요청 → /index.html)이었다.
# 원본은 ~/htaccess.spa.bak 에 백업해 뒀다. 정적 배포로 되돌리려면 그 파일을 복원할 것.
#
# 앱 재시작:  pm2 restart arumtech
# 앱 로그:    pm2 logs arumtech
# 재배포:     cd ~/app && git pull && npm ci && npm run build && pm2 restart arumtech

# DirectoryIndex 를 끈다. 켜져 있으면 "/" 요청이 "/index.html" 서브리퀘스트로 바뀌어
# Next 로 /index.html 이 전달되고, 그런 경로가 없으므로 홈이 404 가 된다.
DirectoryIndex disabled

RewriteEngine On

# Let's Encrypt 갱신 경로는 Apache 가 직접 처리한다.
RewriteCond %{REQUEST_URI} !^/\.well-known/

# 나머지 전부 Next 로 넘긴다 (정적 파일도 Next 가 서빙한다).
#
# NE(noescape) 가 반드시 필요하다. Next 의 라우트별 청크 경로에는 괄호와 대괄호가 들어간다
# (예: /_next/static/chunks/app/(site)/about/news/%5Bidx%5D/page-xxxx.js).
# NE 없이 mod_rewrite 가 경로를 다시 이스케이프하면 괄호가 %28/%29 로 바뀌는데,
# Next 는 그 형태를 404 로 처리한다 (대괄호는 %5B·리터럴 둘 다 받는다).
# 청크를 못 받으면 브라우저가 "client-side exception" 으로 죽는다.
RewriteRule ^(.*)$ http://127.0.0.1:3100/$1 [P,NE,QSA,L]
